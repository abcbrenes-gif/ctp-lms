{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/redactar-instruccion-examen",
      "destination": "/api/ia?fn=redactar-instruccion-examen"
    },
    {
      "source": "/api/planear-examen",
      "destination": "/api/ia?fn=planear-examen"
    },
    {
      "source": "/api/generar-examen-ia",
      "destination": "/api/ia?fn=generar-examen-ia"
    },
    {
      "source": "/api/revisar-ley-infografia",
      "destination": "/api/ia?fn=revisar-ley-infografia"
    },
    {
      "source": "/api/plan-practica-ia",
      "destination": "/api/ia?fn=plan-practica-ia"
    },
    {
      "source": "/api/padres",
      "destination": "/api/ia?fn=padres"
    },
    {
      "source": "/api/taller-facturas-ia",
      "destination": "/api/ia?fn=taller-facturas-ia"
    }
  ],
  "headers": [
    {
      "source": "/(js|css)/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
